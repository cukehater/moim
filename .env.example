# Neon (Vercel Storage → 해당 DB → .env.local 탭)
DATABASE_URL=postgresql://neondb_owner:<password>@ep-xxx-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Auth.js — AUTH_SECRET: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=<client_id>.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=
ADMIN_EMAIL=you@gmail.com

# Cloudinary (Settings → API Keys). 앱은 CLOUDINARY_URL을 읽지 않음: 아래 3개 키로 나눠 입력
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<cloud_name>
NEXT_PUBLIC_CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>
